}

.tag{
  color:#a7656d;
  letter-spacing:3px;
  font-size:12px;
  margin-bottom:15px;
}

.intro{
  font-size:17px;
  line-height:1.9;
  margin-bottom:28px;
}

.btn{
  border:0;
  background:#a95763;
  color:white;
  padding:14px 27px;
  border-radius:50px;
  font-size:15px;
  box-shadow:0 8px 20px rgba(169,87,99,.25);
}

.hidden{
  display:none;
}

.letter p{
  margin-bottom:19px;
}

.signature{
  text-align:right;
  margin-top:25px;
  color:#9b5360;
  font-style:italic;
}

.music{
  text-align:center;
  background:#fff8f5;
}

.music-symbol{
  font-size:60px;
  margin:15px;
}

.music-info{
  margin-bottom:22px;
}

#musicText{
