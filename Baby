  font-size:14px;
  color:#91676a;
}

.quiz-card{
  background:#fffdfc;
}

.progress{
  height:7px;
  background:#f0dddd;
  border-radius:10px;
  overflow:hidden;
  margin-bottom:25px;
}

.bar{
  height:100%;
  width:10%;
  background:#b4616c;
  transition:.3s;
}

.number{
  text-align:center;
  color:#a45b64;
  font-size:13px;
  margin-bottom:15px;
}

.question{
  text-align:center;
  font-size:21px;
  line-height:1.6;
  margin-bottom:22px;
}

.answers{
  display:grid;
  gap:11px;
}

.answer{
  background:#fff;
  border:1px solid #ead1cd;
  border-radius:15px;
  padding:14px;
  color:#593b3b;
  font-size:15px;
}

.answer:hover{
  background:#fff0ec;
}

.correct{
  background:#dcefdc!important;
}

.wrong{
  background:#f8dddd!important;
}

#message{
  text-align:center;
  min-height:25px;
  margin-top:17px;
}

.next{
  display:none;
  margin:17px auto 0;
}

